# Auto detect text files and perform LF normalization
* text=auto

# PowerShell files are checked out with Windows line endings
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Documentation and repo metadata use LF
*.md   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
